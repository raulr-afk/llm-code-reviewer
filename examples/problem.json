{
  "title": "Longest substring without repeating characters",
  "function_name": "longest_unique_substring",
  "description": "Return the length of the longest substring of `s` that contains no repeated characters.",
  "timeout": 5,
  "tests": [
    {
      "name": "empty",
      "args": [
        ""
      ],
      "expected": 0
    },
    {
      "name": "single_char",
      "args": [
        "a"
      ],
      "expected": 1
    },
    {
      "name": "all_same",
      "args": [
        "aaaa"
      ],
      "expected": 1
    },
    {
      "name": "classic",
      "args": [
        "abcabcbb"
      ],
      "expected": 3
    },
    {
      "name": "pwwkew",
      "args": [
        "pwwkew"
      ],
      "expected": 3
    },
    {
      "name": "all_unique",
      "args": [
        "abcdef"
      ],
      "expected": 6
    },
    {
      "name": "with_spaces",
      "args": [
        "a b a"
      ],
      "expected": 3
    },
    {
      "name": "large_input",
      "args": [
        ""
      ],
      "expected": 26
    }
  ]
}
